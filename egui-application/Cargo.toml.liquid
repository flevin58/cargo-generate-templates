[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]
publish = false
repository = "https://github.com/{{gh_username}}/{{crate_name}}"
description = "{{description}}"
license = "MIT"

[dependencies]
eframe = { workspace = true, features = ["default"] }
# For image support:
egui_extras = { workspace = true, features = ["default", "image"] }
